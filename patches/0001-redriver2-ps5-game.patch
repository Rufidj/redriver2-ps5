+#ifdef __PROSPERO__
+extern MATRIX frustrum_matrix;
+
+// 32-bit version of FrustrumCheck16: the packed position only has 16 bits (absolute, wrapping), so the true
+// position is rebuilt from the cell origin, which makes the test valid beyond 16 cells from the camera.
+int FrustrumCheck16Near(PACKED_CELL_OBJECT* pcop, int bounding_sphere, const XZPAIR* near)
+{
+	long long dx = (long long)near->x + (short)(pcop->pos.vx - near->x) - camera_position.vx;
+	long long dz = (long long)near->z + (short)(pcop->pos.vz - near->z) - camera_position.vz;
+	long long ang = FRUSTUM_THRESHOLD - bounding_sphere;
+
+	for (int i = 0; i < 3; i++)
+	{
+		long long d = (frustrum_matrix.m[i][0] * dx + frustrum_matrix.m[i][2] * dz) >> 12;
+		if (d < ang)
+			return -1;
+	}
+
+	return 0;
+}
+#endif
