+	void close() { if (fp) fclose(fp); fp = NULL; }
+	long tellg() { return fp ? ftell(fp) : -1; }
+	void seekg(long off, int) { if (fp && fseek(fp, off, SEEK_SET) != 0) bad = true; }
+	void read(char* buf, long count)
+	{
+		if (!fp || (long)fread(buf, 1, (size_t)count, fp) != count)
+			bad = true;
+	}
+	bool fail() const { return bad; }
+private:
+	FILE* fp;
+	bool bad;
+};
