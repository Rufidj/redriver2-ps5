+
+#ifdef __PROSPERO__
+// ---------------------------------------------------------------------------------------------
+// Far-region cache (PS5): the original keeps only a 2x2 "barrel" of 32x32-cell regions in memory,
+// so geometry vanishes at region borders. The whole level spool data is resident in RAM on PC
+// (g_CurrentLevelSpoolData), so extra regions around the player are copied in from it and used
+// for drawing only. Gameplay (collision, roads, AI) keeps using the barrel.
+// ---------------------------------------------------------------------------------------------
+extern char* g_CurrentLevelSpoolData;
+
+#define FAR_MAX_SLOTS 24
+struct FarSlot
+{
+	int region;
+	int objBase;			// index the region's object list was authored for (straddlers + class base)
+	int objCount;
+	CELL_DATA* cells;
+	PACKED_CELL_OBJECT* objs;
+	u_short ptrs[1024];
+	unsigned lastUse;
+};
+
+static FarSlot g_far[FAR_MAX_SLOTS];
+static int g_farSlots = 0;
+static int g_farCellBytes = 0, g_farObjBytes = 0;
+static int g_farArea = -2;
+static unsigned g_farFrame = 0;
+int gFarRegionRadius = 1;		// ini: [game] farRegions (0 = off)
+static PACKED_CELL_OBJECT g_farDummy;
+
+void FarRegions_Reset(void)
+{
+	for (int i = 0; i < FAR_MAX_SLOTS; i++)
+	{
+		free(g_far[i].cells);
+		free(g_far[i].objs);
+		memset(&g_far[i], 0, sizeof(FarSlot));
+		g_far[i].region = -1;
+	}
+	g_farSlots = 0;
+	g_farArea = -2;
+}
+
+static int FarRegionClass(int region)
+{
+	int rx = region % regions_across, rz = region / regions_across;
+	return (rx & 1) + (rz & 1) * 2;
+}
+
+static int BarrelHasRegion(int region)
+{
+	int slot = FarRegionClass(region);
+	return loading_region[slot] == -1 && RoadMapRegions[slot] == region;
+}
+
+int RegionInBarrel(int cellx, int cellz)
+{
+	return BarrelHasRegion(cellx / MAP_REGION_SIZE + (cellz / MAP_REGION_SIZE) * regions_across);
+}
+
+static FarSlot* FarFind(int region)
+{
+	for (int i = 0; i < g_farSlots; i++)
+		if (g_far[i].region == region)
+			return &g_far[i];
+	return NULL;
+}
+
+static int FarAreaOk(Spool* sp)
+{
+	// Only regions that belong entirely to the loaded area: border regions (super_region 255) hold objects of two
+	// areas, and the models of the other one are not in memory (the game only draws them after switching area),
+	// so drawing them from afar shows garbage.
+	return LoadedArea >= 0 && sp->super_region == LoadedArea;
+}
+
+static void FarInitSlots(void)
+{
+	if (g_farSlots)
+		return;
+
+	int n = gFarRegionRadius * 2 + 1;
+	n = n * n;
+	g_farSlots = n > FAR_MAX_SLOTS ? FAR_MAX_SLOTS : n;
+
+	// size of the biggest region in the level
+	g_farCellBytes = 0;
+	g_farObjBytes = 0;
+	for (int r = 0; r < num_regions; r++)
+	{
+		if (spoolinfo_offsets[r] == 0xffff)
+			continue;
+		Spool* sp = (Spool*)(RegionSpoolInfo + spoolinfo_offsets[r]);
+		if (sp->cell_data_size[0] * 2048 > g_farCellBytes) g_farCellBytes = sp->cell_data_size[0] * 2048;
+		if (sp->cell_data_size[2] * 2048 > g_farObjBytes) g_farObjBytes = sp->cell_data_size[2] * 2048;
+	}
+
+	for (int i = 0; i < g_farSlots; i++)
+	{
+		g_far[i].region = -1;
+		g_far[i].cells = (CELL_DATA*)calloc(1, g_farCellBytes + 64);
+		g_far[i].objs = (PACKED_CELL_OBJECT*)calloc(1, g_farObjBytes + 64);
+	}
+
+	g_farDummy.value = 0xffff;
+	g_farDummy.pos.vy = 1;
+	PsyX_Log("far: %d slots, %d KB cells + %d KB objects each\n", g_farSlots, g_farCellBytes / 1024, g_farObjBytes / 1024);
+}
+
+static int FarLoad(FarSlot* fs, int region)
+{
+	Spool* sp = (Spool*)(RegionSpoolInfo + spoolinfo_offsets[region]);
+	const char* src = g_CurrentLevelSpoolData + sp->offset * 2048;
+
+	// layout as written by LoadRegionData: packed cell pointers, cells, cell objects (then road map)
+	const u_char* packed = (const u_char*)src;
+	src += sp->cell_data_size[1] * 2048;
+	memcpy(fs->cells, src, sp->cell_data_size[0] * 2048);
+	src += sp->cell_data_size[0] * 2048;
+	memcpy(fs->objs, src, sp->cell_data_size[2] * 2048);
+
+	// unpack the 32x32 cell pointers; values are relative to the region's own cell block
+	int packtype = *(const int*)(packed + 4);
+	const u_short* in = (const u_short*)(packed + 8);
+
+	if (packtype == 0)
+	{
+		for (int i = 0; i < 1024; i++)
+			fs->ptrs[i] = 0xffff;
+	}
+	else if (packtype == 1)
+	{
+		for (int i = 0; i < 1024; i++)
+			fs->ptrs[i] = *in++;
+	}
+	else if (packtype == 2)
+	{
+		u_int bitpos = 0x8000;
+		u_int pcode = *in++;
+		for (int i = 0; i < 1024; i++)
+		{
+			fs->ptrs[i] = (pcode & bitpos) ? *in++ : 0xffff;
+			bitpos >>= 1;
+			if (bitpos == 0)
+			{
+				bitpos = 0x8000;
+				pcode = *in++;
+			}
+		}
+	}
+	else
+		return 0;
+
+	fs->objBase = num_straddlers + cell_objects_add[FarRegionClass(region)];
+	fs->objCount = sp->cell_data_size[2] * 2048 / sizeof(PACKED_CELL_OBJECT);
+	fs->region = region;
+	return 1;
+}
+
+void FarRegions_Update(int cellx, int cellz)
+{
+	if (gFarRegionRadius <= 0 || regions_across <= 0 || g_CurrentLevelSpoolData == NULL || LoadingArea || LoadedArea < 0)
+		return;
+
+	FarInitSlots();
+
+	// models/textures are per area: drop everything when the area changes
+	if (g_farArea != LoadedArea)
+	{
+		for (int i = 0; i < g_farSlots; i++)
+			g_far[i].region = -1;
+		g_farArea = LoadedArea;
+	}
+
+	g_farFrame++;
+
+	int rx = cellx / MAP_REGION_SIZE, rz = cellz / MAP_REGION_SIZE;
+	int regions_down_n = cells_down / MAP_REGION_SIZE;
+	int loadsLeft = 2;
+
+	for (int dz = -gFarRegionRadius; dz <= gFarRegionRadius; dz++)
+	{
+		for (int dx = -gFarRegionRadius; dx <= gFarRegionRadius; dx++)
+		{
+			int nx = rx + dx, nz = rz + dz;
+			if (nx < 0 || nz < 0 || nx >= regions_across || nz >= regions_down_n)
+				continue;
+
+			int region = nx + nz * regions_across;
+			if (BarrelHasRegion(region))
+				continue;
+
+			FarSlot* fs = FarFind(region);
+			if (fs)
+			{
+				fs->lastUse = g_farFrame;
+				continue;
+			}
+
+			if (loadsLeft <= 0 || spoolinfo_offsets[region] == 0xffff)
+				continue;
+
+			Spool* sp = (Spool*)(RegionSpoolInfo + spoolinfo_offsets[region]);
+			{
+				// debug: log each region's area data once
+				static int logged[1024];
+				if (region < 1024 && !logged[region])
+				{
+					logged[region] = 1;
+					PsyX_Log("far: region %d (%d,%d) super_region=%d nconn=%d conn=[%d,%d] LoadedArea=%d -> %s\n", region, region % regions_across, region / regions_across,
+						sp->super_region, sp->num_connected_areas, sp->connected_areas[0] & 0x3f, sp->connected_areas[1] & 0x3f, LoadedArea, FarAreaOk(sp) ? "load" : "skip");
+				}
+			}
+			if (!FarAreaOk(sp))
+				continue;
+
+			// free slot, else the least recently used one that is not in the wanted window
+			FarSlot* victim = NULL;
+			for (int i = 0; i < g_farSlots; i++)
+			{
+				if (g_far[i].region == -1) { victim = &g_far[i]; break; }
+				if (g_far[i].lastUse != g_farFrame && (!victim || g_far[i].lastUse < victim->lastUse))
+					victim = &g_far[i];
+			}
+			if (!victim)
+				continue;
+
+			victim->region = -1;
+			if (FarLoad(victim, region))
+			{
+				victim->lastUse = g_farFrame;
+				loadsLeft--;
+			}
+		}
+	}
+}
+
+static PACKED_CELL_OBJECT* FarObj(FarSlot* fs, int num)
+{
+	if (num < num_straddlers)
+		return &cell_objects[num];
+
+	int idx = num - fs->objBase;
+	if (idx < 0 || idx >= fs->objCount)
+		return &g_farDummy;
+
+	return &fs->objs[idx];
+}
+
+static PACKED_CELL_OBJECT* FarGetFirstPackedCop(int cellx, int cellz, CELL_ITERATOR* pci, int use_computed, int level)
+{
+	FarSlot* fs = FarFind(cellx / MAP_REGION_SIZE + (cellz / MAP_REGION_SIZE) * regions_across);
+	if (!fs)
+		return NULL;
+
+	u_short ptr = fs->ptrs[(cellz % MAP_REGION_SIZE) * MAP_REGION_SIZE + (cellx % MAP_REGION_SIZE)];
+	if (ptr == 0xffff)
+		return NULL;
+
+	CELL_DATA* cell = &fs->cells[ptr];
+
+	if (level == -1)
+	{
+		if (cell->num & 0x4000)
+			return NULL;
+	}
+	else
+	{
+		level |= 0x4000;
+		while (cell->num != level)
+		{
+			cell++;
+			if (cell->num & 0x8000)
+				return NULL;
+		}
+		cell++;
+	}
+
+	pci->nearCell.x = (cellx - (cells_across / 2)) * MAP_CELL_SIZE;
+	pci->nearCell.z = (cellz - (cells_down / 2)) * MAP_CELL_SIZE;
+	pci->use_computed = use_computed;
+	pci->pcd = cell;
+	pci->farCtx = fs;
+
+	int num = cell->num & 16383;
+	PACKED_CELL_OBJECT* ppco = FarObj(fs, num);
+
+	if (ppco->value == 0xffff && (ppco->pos.vy & 1))
+	{
+		ppco = GetNextPackedCop(pci);
+	}
+	else if (use_computed && num < num_straddlers)
+	{
+		u_int value = 1 << (num & 7);
+		if (cell_object_computed_values[num / 8] & value)
+		{
+			ppco = GetNextPackedCop(pci);
+			pci->ppco = ppco;
+			return ppco;
+		}
+		cell_object_computed_values[num / 8] |= value;
+	}
+
+	pci->ppco = ppco;
+	return ppco;
+}
+
+static PACKED_CELL_OBJECT* FarGetNextPackedCop(CELL_ITERATOR* pci)
+{
+	FarSlot* fs = (FarSlot*)pci->farCtx;
+	CELL_DATA* celld = pci->pcd;
+	PACKED_CELL_OBJECT* ppco;
+	int num;
+
+	do {
+		do {
+			if (celld->num & 0x8000)
+				return NULL;
+
+			celld++;
+			num = celld->num;
+
+			if (num & 0x4000)
+				return NULL;
+
+			num &= 16383;
+			ppco = FarObj(fs, num);
+		} while (ppco->value == 0xffff && (ppco->pos.vy & 1));
+
+		if (!pci->use_computed || num >= num_straddlers)
+			break;
+
+		u_int value = 1 << (num & 7);
+		if ((cell_object_computed_values[num / 8] & value) == 0)
+		{
+			cell_object_computed_values[num / 8] |= value;
+			break;
+		}
+	} while (true);
+
+	pci->pcd = celld;
+	pci->ppco = ppco;
+	return ppco;
+}
+#endif // __PROSPERO__
+
