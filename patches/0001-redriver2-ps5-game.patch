+static void EmitShadowCasters(int camCellX, int camCellZ, int level)
+{
+	CELL_ITERATOR ci;
+	const int r = gShadowCastRadius;
+
+	for (int dz = -r; dz <= r; dz++)
+	{
+		for (int dx = -r; dx <= r; dx++)
+		{
+			if (dx * dx + dz * dz > r * r)
+				continue;
+
+			const int cx = camCellX + dx, cz = camCellZ + dz;
+			if (cx < 0 || cx >= cells_across || cz < 0 || cz >= cells_down)
+				continue;
+
+			for (PACKED_CELL_OBJECT* ppco = GetFirstPackedCop(cx, cz, &ci, 0, level); ppco; ppco = GetNextPackedCop(&ci))
+			{
+				MODEL* model = modelpointers[(ppco->value >> 6) | ((ppco->pos).vy & 1) << 10];
+				if (model)
+					EmitObjectShadowCaster(ppco, model, &ci.nearCell);
+			}
+		}
+	}
+}
