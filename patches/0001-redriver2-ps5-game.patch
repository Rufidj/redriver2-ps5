 #ifndef PSX
+#ifdef __PROSPERO__
+#include <sys/stat.h>
+// PS5: no HOME. Use the first writable of these directories (probed once, result is logged).
+static const char* PS5_SaveDir()
+{
+	static const char* chosen = NULL;
+	static const char* const candidates[] = { "/data/redriver2", "/app0/save" };
+	if (chosen)
+		return chosen;
+
+	for (int i = 0; i < 2 && !chosen; i++)
+	{
+		char probe[128];
+		mkdir(candidates[i], 0777);
+		sprintf(probe, "%s/.probe", candidates[i]);
+		FILE* fp = fopen(probe, "wb");
+		PsyX_Log("save: probe %s -> %s\n", candidates[i], fp ? "writable" : "no");
+		if (fp)
+		{
+			fclose(fp);
+			chosen = candidates[i];
+		}
+	}
+
+	if (!chosen)
+		chosen = candidates[1];
+	return chosen;
+}
+#endif
+
 void GetGameProfilePath(char* str)
 {
+#ifdef __PROSPERO__
+	strcpy(str, PS5_SaveDir());
+	return;
+#endif
 	char* homepath;
 
 	homepath = getenv(HOME_ENV); // "USERPROFILE"
