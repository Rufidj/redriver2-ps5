+#define ios_base PS5IosBase
+class PS5File
+{
+public:
+	PS5File() : fp(NULL), bad(false) {}
+	~PS5File() { close(); }
+	void open(const char* name, int mode)
+	{
+		close();
+		fp = fopen(name, "rb");
+		bad = (fp == NULL);
+		if (fp && (mode & ios_base::ate))
+			fseek(fp, 0, SEEK_END);
+	}
+	bool is_open() const { return fp != NULL; }
+	void close() { if (fp) fclose(fp); fp = NULL; }
+	long tellg() { return fp ? ftell(fp) : -1; }
+	void seekg(long off, int) { if (fp && fseek(fp, off, SEEK_SET) != 0) bad = true; }
+	void read(char* buf, long count)
+	{
+		if (!fp || (long)fread(buf, 1, (size_t)count, fp) != count)
+			bad = true;
+	}
+	bool fail() const { return bad; }
+private:
+	FILE* fp;
+	bool bad;
+};
+#else
 #include <fstream>
+#endif
