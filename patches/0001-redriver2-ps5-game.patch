diff --git a/src_rebuild/Game/C/farmesh.c b/src_rebuild/Game/C/farmesh.c
new file mode 100644
index 0000000..f40c1fe
--- /dev/null
+++ b/src_rebuild/Game/C/farmesh.c
@@ -0,0 +1,555 @@
+// The far field of the PS5 mod: the map beyond the game's own drawing range, as static meshes.
+//
+// The PSX pipeline cannot reach far: the GTE saturates depth at 16 bits (~32 cells) and the game walks every cell and
+// transforms every polygon on the CPU each frame. Here each 8x8 cells of the loaded area (a "chunk") is baked once into
+// world-space triangles (buildings and ground, the same textured quads the game plots) and the renderer draws them every
+// frame from the camera, on the GPU. Only regions of the loaded area are baked: models and textures are per area.
+#ifdef __PROSPERO__
+#include "driver2.h"
+#include "draw.h"
+#include "main.h"
+#include "map.h"
+#include "models.h"
+#include "system.h"
+#include "camera.h"
+#include "dr2roads.h"
+#include "mission.h"
+#include "cell.h"
+#include "texture.h"
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+// the renderer's vertex (20 bytes): position relative to the chunk's origin, the tpage/clut as the game gives them,
+// uv, a colour selector (0..31 the lit-wall table, 32 the combo colour, 33 the ground colour), flags (1 water or grass
+// ground, 2 ground)
+typedef struct
+{
+	float x, y, z;
+	unsigned short page, clut;
+	unsigned char u, v, col, flags;
+} FarVertex;
+
+extern void GR_PS5_FarChunkSet(int key, int fmt, int ox, int oy, int oz, const FarVertex* v, int count);
+extern void GR_PS5_FarClear(void);
+extern void GR_PS5_FarFlush(void);
+extern void GR_PS5_FarDraw(int key);
+extern void GR_PS5_FarFrame(int camX, int camY, int camZ, const unsigned int* colours);
+extern int g_cfg_farMesh;		// [render] farMesh: how many regions around the camera are baked (0 = off)
+extern int g_cfg_farMeshNear;	// [render] farMeshNear: cells around the camera left to the game's own drawing
+
+extern void ConvertPolygonTypes(MODEL* model, _pct* pc);
+extern char* g_CurrentLevelSpoolData;
+extern int LoadingArea;
+extern void GR_PS5_FarPageSet(int page, const unsigned char* idx, int npal, const unsigned short* pal);
+extern int FarMesh_NumAreas(void);
+extern const char* FarMesh_SpoolPtr(int offset);
+extern int FarMesh_AreaInfo(int area, int* modelOffset, int* modelSize, int* gfxOffset, int* numTPages, const unsigned char** tpages);
+extern unsigned short vram[];
+extern char g_CurrentLevelFileName[64];
+extern int FarMesh_RegionOk(int region);
+typedef void (*FarObjCb)(PACKED_CELL_OBJECT* ppco, XZPAIR* nearCell, int cellx, int cellz);
+extern int FarMesh_ForEachObject(int region, FarObjCb cb);
+
+// ---- the data the bake needs, independent of what the game has loaded now ----
+// Models: every area's block copied out of the spool lump (kept in RAM by the PC port), over the permanent ones;
+// model numbers are global to the level. Texture pages: the same, into the renderer's page store.
+// the spool lump is 16 MB; an area entry is real when it has pages and its blocks lie inside it (the table has empty or
+// junk entries between the real areas)
+#define FAR_LUMP_SECTORS (16 * 1024 * 1024 / 2048)
+static int AreaValid(int mo, int ms, int go, int nt)
+{
+	return nt >= 1 && nt <= 16 && ms >= 1 && mo > 0 && go > 0 &&
+		mo + ms <= FAR_LUMP_SECTORS && go + 17 * nt <= FAR_LUMP_SECTORS;
+}
+
+static MODEL* g_fModel[MAX_MODEL_SLOTS];
+static MODEL* g_fLod[MAX_MODEL_SLOTS];
+static unsigned char g_pageState[128];		// 0 unknown, 1 stored, 2 not available
+static int g_dataReady = 0;
+static char g_levelName[64];
+
+static void BuildModels(void)
+{
+	static unsigned char fromArea[MAX_MODEL_SLOTS];
+	memset(g_fModel, 0, sizeof(g_fModel));
+	memset(g_fLod, 0, sizeof(g_fLod));
+	memset(fromArea, 0, sizeof(fromArea));
+
+	const int nAreas = FarMesh_NumAreas();
+	PsyX_Log("farmesh: building the models of %d areas\n", nAreas);
+	for (int a = 0; a < nAreas; a++)
+	{
+		int mo, ms, go, nt;
+		const unsigned char* tp;
+		if (!FarMesh_AreaInfo(a, &mo, &ms, &go, &nt, &tp) || !AreaValid(mo, ms, go, nt))
+			continue;
+		const char* src = FarMesh_SpoolPtr(mo);
+		PsyX_Log("farmesh: area %d model block at sector %d, %d sectors, %d tpages, src %p\n", a, mo, ms, nt, (const void*)src);
+		if (!src)
+			continue;
+		const size_t len = (size_t)ms * 2048;
+		char* copy = (char*)malloc(len);
+		memcpy(copy, src, len);
+		const unsigned short* newm = (const unsigned short*)(copy + (size_t)(ms - 1) * 2048);
+		int n = newm[0];
+		if (n < 0 || n > MAX_MODEL_SLOTS || (size_t)(n + 1) * 2 > 2048)
+			continue;
+		const unsigned short* nums = newm + 1;
+		PsyX_Log("farmesh: area %d lists %d models\n", a, n);
+		char* addr = copy;
+		for (int i = 0; i < n && addr + 8 < copy + len; i++)
+		{
+			const int m = nums[i];
+			const int size = *(int*)addr;
+			MODEL* model = (MODEL*)(addr + 4);
+			if (m >= 0 && m < MAX_MODEL_SLOTS && !g_fModel[m])
+			{
+				g_fModel[m] = model;
+				fromArea[m] = 1;
+			}
+			addr += size + 4;
+		}
+	}
+
+	PsyX_Log("farmesh: area models copied\n");
+	// the permanent models (not in any area's list) are the game's own, stable in memory
+	for (int m = 0; m < MAX_MODEL_SLOTS; m++)
+		if (!g_fModel[m])
+			g_fModel[m] = modelpointers[m];
+
+	// the models of the areas are processed as the game processes them when it loads an area; instanced models look
+	// their parent up in the global table, so it holds all of them meanwhile
+	static MODEL* saveModels[MAX_MODEL_SLOTS];
+	memcpy(saveModels, modelpointers, sizeof(saveModels));
+	memcpy(modelpointers, g_fModel, sizeof(saveModels));
+	PsyX_Log("farmesh: processing the models\n");
+	for (int m = 0; m < MAX_MODEL_SLOTS; m++)
+	{
+		if (!fromArea[m] || !g_fModel[m])
+			continue;
+		const MODEL* model = g_fModel[m];
+		if (model->instance_number != -1 && (model->instance_number < 0 || model->instance_number >= MAX_MODEL_SLOTS || !g_fModel[model->instance_number]))
+			continue;	// its parent is not in the level's tables
+		ProcessModel(m);
+	}
+	memcpy(modelpointers, saveModels, sizeof(saveModels));
+	PsyX_Log("farmesh: models processed\n");
+
+	for (int m = 0; m < MAX_MODEL_SLOTS; m++)
+	{
+		g_fLod[m] = g_fModel[m];
+		if (g_fModel[m] && Low2LowerDetailTable)
+		{
+			const unsigned short lod = Low2LowerDetailTable[m];
+			if (lod != 0xffff && lod != m && lod < MAX_MODEL_SLOTS && g_fModel[lod])
+				g_fLod[m] = g_fModel[lod];
+		}
+	}
+	PsyX_Log("farmesh: models of %d areas ready\n", nAreas);
+}
+
+// a texture page of the level into the renderer's page store, from the area that owns it or, failing that, from VRAM
+static int EnsurePage(int page)
+{
+	static unsigned char idx[256 * 256];
+	if (page < 0 || page >= 128)
+		return 0;
+	if (g_pageState[page])
+		return g_pageState[page] == 1;
+
+	const int nAreas = FarMesh_NumAreas();
+	for (int a = 0; a < nAreas; a++)
+	{
+		int mo, ms, go, nt;
+		const unsigned char* tp;
+		if (!FarMesh_AreaInfo(a, &mo, &ms, &go, &nt, &tp) || !AreaValid(mo, ms, go, nt))
+			continue;
+		for (int i = 0; i < nt; i++)
+		{
+			if (tp[i] != page)
+				continue;
+			// 17 sectors: the palettes (a count, then 16 colours each), then 256 rows of 128 bytes of 4-bit pixels
+			const unsigned char* blk = (const unsigned char*)FarMesh_SpoolPtr(go + 17 * i);
+			if (!blk)
+				continue;
+			const int npal = *(const int*)blk;
+			const unsigned short* pal = (const unsigned short*)(blk + 4);
+			const unsigned char* pix = blk + 2048;
+			for (int k = 0; k < 256 * 128; k++)
+			{
+				idx[k * 2] = pix[k] & 15;
+				idx[k * 2 + 1] = pix[k] >> 4;
+			}
+			GR_PS5_FarPageSet(page, idx, npal > 64 ? 64 : npal, pal);
+			g_pageState[page] = 1;
+			return 1;
+		}
+	}
+
+	// a permanent page: whatever the game has in VRAM now
+	const unsigned short tp = texture_pages[page];
+	if (tp != 0)
+	{
+		const int px = (tp & 15) * 64, py = ((tp >> 4) & 1) * 256;
+		for (int y = 0; y < 256; y++)
+			for (int x = 0; x < 64; x++)
+			{
+				const unsigned short w = vram[(py + y) * 1024 + px + x];
+				unsigned char* o = &idx[y * 256 + x * 4];
+				o[0] = w & 15; o[1] = (w >> 4) & 15; o[2] = (w >> 8) & 15; o[3] = (w >> 12) & 15;
+			}
+		unsigned short pal[64 * 16];
+		int npal = 0;
+		for (int i = 0; i < 32; i++)
+		{
+			const unsigned short clut = texture_cluts[page][i];
+			if (clut == 0)
+				break;
+			const int cx = (clut & 63) * 16, cy = clut >> 6;
+			for (int k = 0; k < 16; k++)
+				pal[i * 16 + k] = vram[cy * 1024 + cx + k];
+			npal = i + 1;
+		}
+		GR_PS5_FarPageSet(page, idx, npal, pal);
+		g_pageState[page] = 1;
+		return 1;
+	}
+	g_pageState[page] = 2;
+	return 0;
+}
+
+typedef struct { FarVertex* v; int n, cap; } Bucket;
+static Bucket g_bk[16][3];			// the chunk being built, by texture format
+static int g_bakeRegion = -1;
+static unsigned char g_state[1024];	// per region: 0 not tried, 1 baked, 2 not bakeable (other area)
+static int g_area = -2;
+
+static void Push(Bucket* b, const FarVertex* v)
+{
+	if (b->n == b->cap)
+	{
+		b->cap = b->cap ? b->cap * 2 : 4096;
+		b->v = (FarVertex*)realloc(b->v, sizeof(FarVertex) * b->cap);
+	}
+	b->v[b->n++] = *v;
+}
+
+// one textured quad (the game's vertex order v0 v1 v3 v2) as two triangles (0 1 2) (1 2 3)
+static void AddQuad(Bucket* b, const float p[4][3], const UV_INFO uv[4], unsigned short page, unsigned short clut, int col, int flags)
+{
+	static const int tri[6] = { 0, 1, 2, 1, 2, 3 };
+	for (int k = 0; k < 6; k++)
+	{
+		const int i = tri[k];
+		FarVertex v;
+		v.x = p[i][0]; v.y = p[i][1]; v.z = p[i][2];
+		v.page = page; v.clut = clut;
+		v.u = uv[i].u; v.v = uv[i].v;
+		v.col = (unsigned char)col; v.flags = (unsigned char)flags;
+		Push(b, &v);
+	}
+}
+
+// Sprites (trees, lamps, signs) face the camera in the game: far away they become two crossed quads standing at the
+// same place (seen from any side one of them is face on), double sided, with their transparent texels dropped.
+static void BakeSprite(const CELL_OBJECT& co, MODEL* model, int cellx, int cellz)
+{
+	const int rcx = cellx % MAP_REGION_SIZE, rcz = cellz % MAP_REGION_SIZE;
+	const int chunk = ((rcz >> 3) << 2) + (rcx >> 3);
+	const float ox = (float)(((cellx - (rcx & 7)) - (cells_across / 2)) * MAP_CELL_SIZE);
+	const float oz = (float)(((cellz - (rcz & 7)) - (cells_down / 2)) * MAP_CELL_SIZE);
+
+	SVECTOR* src = GET_MODEL_DATA(SVECTOR, model, vertices);
+	POLYFT4* polys = GET_MODEL_DATA(POLYFT4, model, poly_block);
+
+	for (int n = 0; n < (int)model->num_polys; n++, polys++)
+	{
+		const unsigned short page = polys->texture_set;
+		const unsigned short clut = polys->texture_id;
+		if (!EnsurePage(page))
+			continue;
+
+		const int idx[4] = { polys->v0, polys->v1, polys->v3, polys->v2 };
+		const UV_INFO uv[4] = { polys->uv0, polys->uv1, polys->uv3, polys->uv2 };
+
+		for (int cross = 0; cross < 2; cross++)
+		{
+			float p[4][3];
+			for (int k = 0; k < 4; k++)
+			{
+				const SVECTOR* sv = &src[idx[k]];
+				const float x = (float)sv->vx, y = (float)sv->vy, z = (float)sv->vz;
+				// the second quad is the first turned a quarter about the vertical axis
+				const float wx = cross ? z : x;
+				const float wz = cross ? -x : z;
+				p[k][0] = (float)co.pos.vx + wx - ox;
+				p[k][1] = (float)co.pos.vy + y;
+				p[k][2] = (float)co.pos.vz + wz - oz;
+			}
+
+			AddQuad(&g_bk[chunk][0], p, uv, page, clut, 32, 4);
+
+			// the back face: the same quad with the other winding
+			const float q[4][3] = {
+				{ p[1][0], p[1][1], p[1][2] }, { p[0][0], p[0][1], p[0][2] },
+				{ p[3][0], p[3][1], p[3][2] }, { p[2][0], p[2][1], p[2][2] } };
+			const UV_INFO quv[4] = { uv[1], uv[0], uv[3], uv[2] };
+			AddQuad(&g_bk[chunk][0], q, quv, page, clut, 32, 4);
+		}
+	}
+}
+
+
+static void BakeObject(PACKED_CELL_OBJECT* ppco, XZPAIR* nearCell, int cellx, int cellz)
+{
+	CELL_OBJECT co;
+	QuickUnpackCellObject(ppco, nearCell, &co);
+
+	MODEL* model = g_fModel[co.type];
+	if (!model)
+		return;
+
+	if (model->shape_flags & SHAPE_FLAG_SPRITE)
+	{
+		BakeSprite(co, model, cellx, cellz);
+		return;
+	}
+
+	const int isTile = (model->shape_flags & (SHAPE_FLAG_WATER | SHAPE_FLAG_TILE)) || (model->flags2 & (MODEL_FLAG_PATH | MODEL_FLAG_GRASS));
+	const int isWet = (model->shape_flags & SHAPE_FLAG_WATER) || (model->flags2 & MODEL_FLAG_GRASS);
+	MODEL* use = g_fLod[co.type] ? g_fLod[co.type] : model;
+
+	plotContext.polySizes = PolySizes;
+	ConvertPolygonTypes(use, &plotContext);
+
+	// chunk of this cell and its origin (world)
+	const int rcx = cellx % MAP_REGION_SIZE, rcz = cellz % MAP_REGION_SIZE;
+	const int chunk = ((rcz >> 3) << 2) + (rcx >> 3);
+	const float ox = (float)(((cellx - (rcx & 7)) - (cells_across / 2)) * MAP_CELL_SIZE);
+	const float oz = (float)(((cellz - (rcz & 7)) - (cells_down / 2)) * MAP_CELL_SIZE);
+
+	// model -> world: the object's rotation about Y (matrixtable, 4096 = 1) and its position
+	const int yang = co.yang;
+	float R[3][3];
+	for (int i = 0; i < 3; i++)
+		for (int j = 0; j < 3; j++)
+			R[i][j] = yang > 0 ? (float)matrixtable[yang].m[i][j] / 4096.0f : (i == j ? 1.0f : 0.0f);
+
+	SVECTOR* src = GET_MODEL_DATA(SVECTOR, use, vertices);
+	PL_POLYFT4* polys = GET_MODEL_DATA(PL_POLYFT4, use, poly_block);
+	const int rotCol = (yang >> 3) * 4;
+
+	int i = use->num_polys;
+	while (i-- > 0)
+	{
+		const u_char ptype = polys->id & 31;
+		PL_POLYFT4* next = (PL_POLYFT4*)((char*)polys + PolySizes[ptype]);
+
+		if (!isTile && ptype != 11 && ptype != 21 && ptype != 23)
+		{
+			polys = next;
+			continue;
+		}
+
+		// the far field's store addresses a texture by page id and palette index
+		const unsigned short page = polys->texture_set;
+		const unsigned short clut = polys->texture_id;
+		const int fmt = 0;
+		if (!EnsurePage(page))
+		{
+			polys = next;
+			continue;
+		}
+
+		const int idx[4] = { polys->v0, polys->v1, polys->v3, polys->v2 };
+		const UV_INFO uv[4] = { polys->uv0, polys->uv1, polys->uv3, polys->uv2 };
+		float p[4][3];
+		for (int k = 0; k < 4; k++)
+		{
+			const SVECTOR* sv = &src[idx[k]];
+			const float x = (float)sv->vx, y = (float)sv->vy, z = (float)sv->vz;
+			p[k][0] = (float)co.pos.vx + R[0][0] * x + R[0][1] * y + R[0][2] * z - ox;
+			p[k][1] = (float)co.pos.vy + R[1][0] * x + R[1][1] * y + R[1][2] * z;
+			p[k][2] = (float)co.pos.vz + R[2][0] * x + R[2][1] * y + R[2][2] * z - oz;
+		}
+
+		int col, flags;
+		if (isTile)
+		{
+			col = 33;
+			flags = 2 | (isWet ? 1 : 0);
+		}
+		else
+		{
+			col = (ptype == 21) ? 32 : ((rotCol - polys->th) & 31);
+			flags = 0;
+		}
+		AddQuad(&g_bk[chunk][fmt], p, uv, page, clut, col, flags);
+		polys = next;
+	}
+}
+
+static void BakeRegion(int region)
+{
+	// the model getters of instanced models look in the global table: give them the far field's
+	static MODEL* saveModels[MAX_MODEL_SLOTS];
+	memcpy(saveModels, modelpointers, sizeof(saveModels));
+	memcpy(modelpointers, g_fModel, sizeof(saveModels));
+
+	for (int c = 0; c < 16; c++)
+		for (int f = 0; f < 3; f++)
+			g_bk[c][f].n = 0;
+
+	if (!FarMesh_ForEachObject(region, BakeObject))
+	{
+		memcpy(modelpointers, saveModels, sizeof(saveModels));
+		g_state[region] = 2;
+		return;
+	}
+	memcpy(modelpointers, saveModels, sizeof(saveModels));
+
+	const int rx = region % regions_across, rz = region / regions_across;
+	int total = 0;
+	for (int c = 0; c < 16; c++)
+	{
+		const int cx = rx * MAP_REGION_SIZE + (c & 3) * 8, cz = rz * MAP_REGION_SIZE + (c >> 2) * 8;
+		const int ox = (cx - cells_across / 2) * MAP_CELL_SIZE, oz = (cz - cells_down / 2) * MAP_CELL_SIZE;
+		for (int f = 0; f < 3; f++)
+		{
+			if (g_bk[c][f].n > 0)
+			{
+				GR_PS5_FarChunkSet(region * 16 + c, f, ox, 0, oz, g_bk[c][f].v, g_bk[c][f].n);
+				total += g_bk[c][f].n;
+			}
+		}
+	}
+	GR_PS5_FarFlush();
+	g_state[region] = 1;
+	PsyX_Log("farmesh: region %d (%d,%d) baked, %d vertices\n", region, rx, rz, total);
+}
+
+// the colour of the ground tiles as DrawTILES computes it
+static unsigned int TileColour(void)
+{
+	unsigned int colour = 0x2C000000;
+	const int combo = combointensity;
+	if (gTimeOfDay > -1)
+	{
+		if (gTimeOfDay < TIME_NIGHT)
+			colour = combo & 0xffffffU | 0x2C000000;
+		else if (gTimeOfDay == TIME_NIGHT)
+			colour = ((combo >> 16 & 255) * 171 >> 9) << 16 | ((combo >> 8 & 255) * 171 >> 9) << 8 | ((combo & 255) * 171 >> 9) | 0x2C000000U;
+	}
+	if (gWeather - 1U < 2)
+	{
+		unsigned int col = colour >> 2 & 63;
+		colour = col * 0x30000 | col * 0x300 | col * 3 | 0x2C000000;
+	}
+	return colour;
+}
+
+// ---- water: the game's own sea. Cells without surface data are the sea plane (GetSeaPlane: cars drown there); its height is
+// the level's water level ----
+extern void GR_PS5_WaterSet(int on, float worldY);
+extern int sdHeightOnPlane(VECTOR* pos, sdPlane* plane);
+extern int g_cfg_water;		// [render] water: the water plane under the world (0 = off)
+static float WaterWorldY(void)
+{
+	VECTOR p;
+	p.vx = p.vy = p.vz = 0;
+	// the world's y points down: the surface is at -height; a little lower so that the game's water tiles draw over it
+	return (float)(-sdHeightOnPlane(&p, GetSeaPlane())) + 12.0f;
+}
+
+void FarMesh_Update(int camCellX, int camCellZ)
+{
+	if (g_cfg_farMesh <= 0 || regions_across <= 0 || g_CurrentLevelSpoolData == NULL || LoadingArea || LoadedArea < 0)
+		return;
+
+	// a new level is a new set of meshes, models and pages (an area change is not: all areas are in the far field)
+	if (!g_dataReady || strcmp(g_levelName, g_CurrentLevelFileName) != 0)
+	{
+		GR_PS5_FarClear();
+		memset(g_state, 0, sizeof(g_state));
+		memset(g_pageState, 0, sizeof(g_pageState));
+		strncpy(g_levelName, g_CurrentLevelFileName, sizeof(g_levelName) - 1);
+		BuildModels();
+		g_dataReady = 1;
+	}
+
+	// every level has a sea except the desert
+	GR_PS5_WaterSet(g_cfg_water && GameLevel != 2, WaterWorldY());
+
+	const int rx = camCellX / MAP_REGION_SIZE, rz = camCellZ / MAP_REGION_SIZE;
+	const int regionsDown = cells_down / MAP_REGION_SIZE;
+	const int R = g_cfg_farMesh;
+
+	// one region per frame, the nearest not yet baked first
+	int baked = 0;
+	for (int d = 0; d <= R && !baked; d++)
+	{
+		for (int dz = -d; dz <= d && !baked; dz++)
+		{
+			for (int dx = -d; dx <= d && !baked; dx++)
+			{
+				if (abs(dx) != d && abs(dz) != d)
+					continue;
+				const int nx = rx + dx, nz = rz + dz;
+				if (nx < 0 || nz < 0 || nx >= regions_across || nz >= regionsDown)
+					continue;
+				const int region = nx + nz * regions_across;
+				if (region >= 1024 || g_state[region] != 0)
+					continue;
+				if (!FarMesh_RegionOk(region))
+				{
+					g_state[region] = 2;
+					continue;
+				}
+				BakeRegion(region);
+				baked = 1;
+			}
+		}
+	}
+
+	// the chunks to draw this frame: baked, outside the near range, in front of the camera
+	const MATRIX* M = &inv_camera_matrix;
+	const float near = (float)g_cfg_farMeshNear * MAP_CELL_SIZE;
+	for (int dz = -R; dz <= R; dz++)
+	{
+		for (int dx = -R; dx <= R; dx++)
+		{
+			const int nx = rx + dx, nz = rz + dz;
+			if (nx < 0 || nz < 0 || nx >= regions_across || nz >= regionsDown)
+				continue;
+			const int region = nx + nz * regions_across;
+			if (region >= 1024 || g_state[region] != 1)
+				continue;
+			for (int c = 0; c < 16; c++)
+			{
+				const int cx = nx * MAP_REGION_SIZE + (c & 3) * 8, cz = nz * MAP_REGION_SIZE + (c >> 2) * 8;
+				// chunk centre, relative to the camera
+				const float wx = (float)((cx + 4 - cells_across / 2) * MAP_CELL_SIZE) - (float)camera_position.vx;
+				const float wz = (float)((cz + 4 - cells_down / 2) * MAP_CELL_SIZE) - (float)camera_position.vz;
+				const float rad = 4.0f * MAP_CELL_SIZE * 1.5f;
+				// all of it inside the near square: the game draws it
+				if (fabsf(wx) + rad * 0.7f < near && fabsf(wz) + rad * 0.7f < near)
+					continue;
+				const float vx = (M->m[0][0] * wx + M->m[0][2] * wz) / 4096.0f;
+				const float vz = (M->m[2][0] * wx + M->m[2][2] * wz) / 4096.0f;
+				if (vz + rad < 0.0f || fabsf(vx) > (vz + rad) * 1.3f + rad)
+					continue;
+				GR_PS5_FarDraw(region * 16 + c);
+			}
+		}
+	}
+
+	unsigned int colours[36];
+	for (int i = 0; i < 32; i++)
+		colours[i] = plotContext.f4colourTable[i];
+	colours[32] = (unsigned int)combointensity & 0x2ffffff | 0x2c000000;
+	colours[33] = TileColour();
+	colours[34] = colours[35] = 0;
+	GR_PS5_FarFrame(camera_position.vx, camera_position.vy, camera_position.vz, colours);
+}
