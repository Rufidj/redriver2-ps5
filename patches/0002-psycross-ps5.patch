+void PGXP_ShadowCasterTri(const void* va, const void* vb, const void* vc)
+{
+	if (g_shcCount >= SHC_MAX_TRIS)
+		return;
+
+	const SVECTOR* v[3] = { (const SVECTOR*)va, (const SVECTOR*)vb, (const SVECTOR*)vc };
+	const double one_by_v = 1.0 / (512.0 * 1024.0);
+	float* o = &g_shcTris[g_shcCount * 9];
+
+	for (int i = 0; i < 3; i++)
+	{
+		const float x = (float)v[i]->vx, y = (float)v[i]->vy, z = (float)v[i]->vz;
