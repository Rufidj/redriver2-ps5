+static int g_shPassCounter = 0, g_shDumpPending = 0;
+static float g_shDbgSun[3], g_shDbgFocus[3], g_shDbgFwd[3];
+static GLint g_shSavedFBO = 0, g_shSavedViewport[4];
+static GLboolean g_shSavedDepth = GL_FALSE, g_shSavedBlend = GL_FALSE, g_shSavedScissor = GL_FALSE;
+typedef void (*PFN_PUM)(GLuint, GLint, GLsizei, GLboolean, const GLfloat*);
+typedef void (*PFN_PU1I)(GLuint, GLint, GLint);
+typedef void (*PFN_PU1F)(GLuint, GLint, GLfloat);
+static PFN_PUM g_pgl_PUM3 = NULL, g_pgl_PUM4 = NULL;
+static PFN_PU1I g_pgl_PU1I = NULL;
+static PFN_PU1F g_pgl_PU1F = NULL;
+
+int g_cfg_ps5Fog = 0;
+int g_cfg_ps5FogStart = 12, g_cfg_ps5FogEnd = 30;	// map cells
+int g_cfg_ps5FogR = 190, g_cfg_ps5FogG = 205, g_cfg_ps5FogB = 225;
+static GLint u_fogOn = -1, u_fogR = -1, u_fogG = -1, u_fogB = -1, u_fogStart = -1, u_fogEnd = -1;
+
+// colour of the haze: the configured one scaled by the game's sky brightness (so it darkens at night)
+void GR_PS5_SetFog(int skyR, int skyG, int skyB)
+{
+	if (!g_cfg_ps5Fog || !g_pgl_PU1F || !g_pgl_PU1I || !g_shadowProg)
+		return;
+	const float k[3] = { skyR / 128.0f, skyG / 128.0f, skyB / 128.0f };
+	const float c[3] = { g_cfg_ps5FogR / 255.0f, g_cfg_ps5FogG / 255.0f, g_cfg_ps5FogB / 255.0f };
+	float o[3];
+	for (int i = 0; i < 3; i++) { o[i] = c[i] * (k[i] > 1.0f ? 1.0f : k[i]); }
+	// cells -> shader units (2048 world units per cell, 128 units per shader unit)
+	g_pgl_PU1F(g_shadowProg, u_fogR, o[0]);
+	g_pgl_PU1F(g_shadowProg, u_fogG, o[1]);
+	g_pgl_PU1F(g_shadowProg, u_fogB, o[2]);
+	g_pgl_PU1F(g_shadowProg, u_fogStart, g_cfg_ps5FogStart * 16.0f);
+	g_pgl_PU1F(g_shadowProg, u_fogEnd, g_cfg_ps5FogEnd * 16.0f);
+	g_pgl_PU1I(g_shadowProg, u_fogOn, 1);
+}
+
+void GR_PS5_InitShadows()
+{
+	if (!g_cfg_ps5Shadows && !g_cfg_ps5Fog)
+		return;
+
+	g_shadowProg = g_gpu_shader_4.shader;
+	u_fogOn = glGetUniformLocation(g_shadowProg, "uFogOn");
+	u_fogR = glGetUniformLocation(g_shadowProg, "uFogR");
+	u_fogG = glGetUniformLocation(g_shadowProg, "uFogG");
+	u_fogB = glGetUniformLocation(g_shadowProg, "uFogB");
+	u_fogStart = glGetUniformLocation(g_shadowProg, "uFogStart");
+	u_fogEnd = glGetUniformLocation(g_shadowProg, "uFogEnd");
+	u_shViewToWorld = glGetUniformLocation(g_shadowProg, "uViewToWorld");
+	u_shCutout = glGetUniformLocation(g_shadowProg, "uCutout");
+	u_shCascade = glGetUniformLocation(g_shadowProg, "uCascade");
+	u_shDispW = glGetUniformLocation(g_shadowProg, "uDispW");
+	u_shDispH = glGetUniformLocation(g_shadowProg, "uDispH");
+	u_shLightVP = glGetUniformLocation(g_shadowProg, "uLightVP");
+	u_shPass = glGetUniformLocation(g_shadowProg, "uPass");
+	u_shMap = glGetUniformLocation(g_shadowProg, "uShadowMap");
+	u_shSize = glGetUniformLocation(g_shadowProg, "uShadowSize");
+	u_shStrength = glGetUniformLocation(g_shadowProg, "uShadowStrength");
+	u_shBias = glGetUniformLocation(g_shadowProg, "uShadowBias");
+	u_shDebug = glGetUniformLocation(g_shadowProg, "uShadowDebug");
+
+	g_pgl_PUM3 = (PFN_PUM)PS5_GetProcAddress("glProgramUniformMatrix3fv");
+	g_pgl_PUM4 = (PFN_PUM)PS5_GetProcAddress("glProgramUniformMatrix4fv");
+	g_pgl_PU1I = (PFN_PU1I)PS5_GetProcAddress("glProgramUniform1i");
+	g_pgl_PU1F = (PFN_PU1F)PS5_GetProcAddress("glProgramUniform1f");
+
+	if (!g_cfg_ps5Shadows)
+		return;
+
+	if (g_cfg_ps5ShadowSize < 1024) g_cfg_ps5ShadowSize = 1024;
+	if (g_cfg_ps5ShadowSize > 8192) g_cfg_ps5ShadowSize = 8192;
+	const int S = g_cfg_ps5ShadowSize;
+
+	glGenTextures(1, &g_shadowTex);
+	glBindTexture(GL_TEXTURE_2D_ARRAY, g_shadowTex);
+	glTexImage3D(GL_TEXTURE_2D_ARRAY, 0, GL_DEPTH_COMPONENT24, S, S, 3, 0, GL_DEPTH_COMPONENT, GL_FLOAT, NULL);
+	glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_COMPARE_MODE, GL_COMPARE_REF_TO_TEXTURE);
+	glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_COMPARE_FUNC, GL_LEQUAL);
+	glBindTexture(GL_TEXTURE_2D_ARRAY, 0);
+
+	// one framebuffer per cascade: re-attaching another layer to a single framebuffer is not honoured by this driver
+	GLenum st = GL_FRAMEBUFFER_COMPLETE;
+	for (int c = 0; c < 3; c++)
+	{
+		glGenFramebuffers(1, &g_shadowCascadeFBO[c]);
+		glBindFramebuffer(GL_FRAMEBUFFER, g_shadowCascadeFBO[c]);
+		glFramebufferTextureLayer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, g_shadowTex, 0, c);
+		glDrawBuffer(GL_NONE);
+		glReadBuffer(GL_NONE);
+		const GLenum cst = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+		if (cst != GL_FRAMEBUFFER_COMPLETE)
+			st = cst;
+	}
+	g_shadowFBO = g_shadowCascadeFBO[0];
+	glBindFramebuffer(GL_FRAMEBUFFER, g_screenFBO);
+	eprintf("shadows: map %dx%d, fbo status 0x%x, uniforms v2w=%d lvp=%d pass=%d map=%d\n", S, S, st, u_shViewToWorld, u_shLightVP, u_shPass, u_shMap);
+
+	if (st != GL_FRAMEBUFFER_COMPLETE || !g_pgl_PU1I || !g_pgl_PUM3 || !g_pgl_PUM4 || !g_pgl_PU1F)
+	{
+		eprintf("shadows: disabled (incomplete framebuffer or missing entry points)\n");
+		g_cfg_ps5Shadows = 0;
+		return;
+	}
+
+	g_pgl_PU1I(g_shadowProg, u_shMap, 2);
+	g_pgl_PU1F(g_shadowProg, u_shSize, (float)S);
+	g_pgl_PU1F(g_shadowProg, u_shStrength, g_cfg_ps5ShadowStrength);
+	g_pgl_PU1F(g_shadowProg, u_shBias, 0.0008f);
+	g_pgl_PU1I(g_shadowProg, u_shPass, 0);
+	g_pgl_PU1I(g_shadowProg, u_shDebug, g_cfg_ps5ShadowDebug);
+}
+
+// sun: world vector pointing from the scene towards the sun (game's sun_position); m: the game's inv_camera_matrix
+// (4096 fixed point, view = M * (world - camera)).
+void GR_PS5_SetShadowParams(int sx, int sy, int sz, const short* m, int cx, int cy, int cz)
+{
+	if (!g_cfg_ps5Shadows || !g_shadowFBO)
+		return;
+
+	float M[9];
+	for (int i = 0; i < 9; i++)
+		M[i] = (float)m[i] / 4096.0f;
+
+	// light travels from the sun towards the scene
+	const float flip = g_cfg_ps5ShadowFlip ? -1.0f : 1.0f;
+	float L[3] = { -(float)sx * flip, -(float)sy * flip, -(float)sz * flip };
+	float ll = sqrtf(L[0] * L[0] + L[1] * L[1] + L[2] * L[2]);
+	if (ll < 1.0f)
+		return;
+	for (int i = 0; i < 3; i++) L[i] /= ll;
+
+	float up[3] = { 0.0f, 1.0f, 0.0f };
+	if (fabsf(L[1]) > 0.99f) { up[0] = 1.0f; up[1] = 0.0f; }
+
+	float lx[3] = { up[1] * L[2] - up[2] * L[1], up[2] * L[0] - up[0] * L[2], up[0] * L[1] - up[1] * L[0] };
+	float lxl = sqrtf(lx[0] * lx[0] + lx[1] * lx[1] + lx[2] * lx[2]);
+	for (int i = 0; i < 3; i++) lx[i] /= lxl;
+	float ly[3] = { L[1] * lx[2] - L[2] * lx[1], L[2] * lx[0] - L[0] * lx[2], L[0] * lx[1] - L[1] * lx[0] };
+
+	// three cascades, each a square of half width E centred half a width in front of the camera (camera-relative
+	// world space), the depth range along the light is three times E
+	static const float cascadeE[3] = { 6000.0f, 20000.0f, 60000.0f };
+	float vpAll[48];
+
+	for (int ci = 0; ci < 3; ci++)
+	{
+		const float E = cascadeE[ci];
+		const float R = E * 3.0f;
+		const float focusDist = E * 0.5f;
+		float focus[3] = { M[6] * focusDist, M[7] * focusDist, M[8] * focusDist };
+
+		// snap the focus to the shadow-map texel grid in absolute world space so shadows do not swim as the camera moves
+		{
+			const float texel = 2.0f * E / (float)g_cfg_ps5ShadowSize;
+			const float fa[3] = { focus[0] + cx, focus[1] + cy, focus[2] + cz };
+			const float a = lx[0] * fa[0] + lx[1] * fa[1] + lx[2] * fa[2];
+			const float b = ly[0] * fa[0] + ly[1] * fa[1] + ly[2] * fa[2];
+			const float da = floorf(a / texel + 0.5f) * texel - a;
+			const float db = floorf(b / texel + 0.5f) * texel - b;
+			for (int i = 0; i < 3; i++) focus[i] += lx[i] * da + ly[i] * db;
+		}
+
+		float rows[3][3] = { { lx[0], lx[1], lx[2] }, { ly[0], ly[1], ly[2] }, { L[0], L[1], L[2] } };
+		const float scale[3] = { 1.0f / E, 1.0f / E, 1.0f / R };
+		float* vp = &vpAll[ci * 16];
+		for (int r = 0; r < 3; r++)
+		{
+			const float d = rows[r][0] * focus[0] + rows[r][1] * focus[1] + rows[r][2] * focus[2];
+			for (int c = 0; c < 3; c++)
+				vp[c * 4 + r] = rows[r][c] * scale[r];
+			vp[3 * 4 + r] = -d * scale[r];
+		}
+		vp[0 * 4 + 3] = vp[1 * 4 + 3] = vp[2 * 4 + 3] = 0.0f;
+		vp[3 * 4 + 3] = 1.0f;
+
+		if (ci == 0)
+		{
+			for (int i = 0; i < 16; i++) g_shVP[i] = vp[i];
+			g_shDbgFocus[0] = focus[0]; g_shDbgFocus[1] = focus[1]; g_shDbgFocus[2] = focus[2];
+		}
+	}
+
+	for (int i = 0; i < 9; i++) g_shM[i] = M[i];
+	g_shDbgSun[0] = (float)sx; g_shDbgSun[1] = (float)sy; g_shDbgSun[2] = (float)sz;
+	g_shDbgFwd[0] = M[6]; g_shDbgFwd[1] = M[7]; g_shDbgFwd[2] = M[8];
+
+	// world = M^T * view: the row-major M uploaded as a column-major mat3 is exactly M^T
+	g_pgl_PUM3(g_shadowProg, u_shViewToWorld, 1, GL_FALSE, M);
+	g_pgl_PUM4(g_shadowProg, u_shLightVP, 3, GL_FALSE, vpAll);
+	g_shValid = 1;
+}
+
+void GR_PS5_SetShadowCutout(int on)
+{
+	if (g_pgl_PU1I && g_shadowProg) g_pgl_PU1I(g_shadowProg, u_shCutout, on);
+}
+
+static float g_shDispW = 320, g_shDispH = 240;
+void GR_PS5_SetShadowDisp(float w, float h)
+{
+	g_shDispW = w; g_shDispH = h;
+	if (g_pgl_PU1F && g_shadowProg) { g_pgl_PU1F(g_shadowProg, u_shDispW, w); g_pgl_PU1F(g_shadowProg, u_shDispH, h); }
+}
+
+// selects the cascade (a layer of the shadow texture), clears it and makes the vertex shader project into it
+void GR_PS5_ShadowCascade(int c)
+{
+	glBindFramebuffer(GL_FRAMEBUFFER, g_shadowCascadeFBO[c]);
+	glClear(GL_DEPTH_BUFFER_BIT);
+	g_pgl_PU1I(g_shadowProg, u_shCascade, c);
+}
+
+int GR_PS5_ShadowBegin()
+{
+	if (!g_cfg_ps5Shadows || !g_shValid || !g_shadowFBO)
+		return 0;
+
+	g_shValid = 0;
+	g_shDumpPending = (g_cfg_ps5ShadowDebug == 5 && ++g_shPassCounter % 300 == 150);
+
+	glGetIntegerv(GL_FRAMEBUFFER_BINDING, &g_shSavedFBO);
+	glGetIntegerv(GL_VIEWPORT, g_shSavedViewport);
+
+	glBindFramebuffer(GL_FRAMEBUFFER, g_shadowFBO);
+	glViewport(0, 0, g_cfg_ps5ShadowSize, g_cfg_ps5ShadowSize);
+	glDepthMask(GL_TRUE);
+
+	// Raw GL state (the GR_* caches are left untouched and the real state is restored afterwards): depth is only
+	// written while the depth test is enabled, and the game leaves it off at the start of a frame.
+	g_shSavedDepth = glIsEnabled(GL_DEPTH_TEST);
+	g_shSavedBlend = glIsEnabled(GL_BLEND);
+	g_shSavedScissor = glIsEnabled(GL_SCISSOR_TEST);
+	glEnable(GL_DEPTH_TEST);
+	glDepthFunc(GL_LEQUAL);
+	glDisable(GL_BLEND);
+	glDisable(GL_SCISSOR_TEST);
+	glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
+	glEnable(GL_POLYGON_OFFSET_FILL);
+	glPolygonOffset(2.0f, 4.0f);
+
+	g_pgl_PU1I(g_shadowProg, u_shPass, 1);
+	return 1;
+}
+
+void GR_PS5_ShadowEnd()
+{
+	glDisable(GL_POLYGON_OFFSET_FILL);
+	glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+	if (!g_shSavedDepth) glDisable(GL_DEPTH_TEST);
+	if (g_shSavedBlend) glEnable(GL_BLEND);
+	if (g_shSavedScissor) glEnable(GL_SCISSOR_TEST);
+	glBindFramebuffer(GL_FRAMEBUFFER, g_shSavedFBO);
+	glViewport(g_shSavedViewport[0], g_shSavedViewport[1], g_shSavedViewport[2], g_shSavedViewport[3]);
+
+	glActiveTexture(GL_TEXTURE2);
+	glBindTexture(GL_TEXTURE_2D_ARRAY, g_shadowTex);
+
+	// debug: every 120 passes report how full each cascade is
+	if (g_cfg_ps5ShadowDebug == 5)
+	{
+		static int dumpCounter = 0;
+		if (++dumpCounter % 120 == 60)
+		{
+			const int S = g_cfg_ps5ShadowSize;
+			const size_t layer = (size_t)S * S;
+			float* px = (float*)malloc(layer * 3 * sizeof(float));
+			if (px)
+			{
+				glGetTexImage(GL_TEXTURE_2D_ARRAY, 0, GL_DEPTH_COMPONENT, GL_FLOAT, px);
+				for (int c = 0; c < 3; c++)
+				{
+					size_t filled = 0; double mn = 1e9, mx = -1e9;
+					for (size_t i = 0; i < layer; i++)
+					{
+						const float d = px[c * layer + i];
+						if (d < 0.99999f) { filled++; if (d < mn) mn = d; if (d > mx) mx = d; }
+					}
+					eprintf("shadow cascade %d: filled=%.2f%% depth %.4f..%.4f\n", c, 100.0 * filled / (double)layer, filled ? mn : 0.0, filled ? mx : 0.0);
+				}
+				free(px);
+			}
+			eprintf("shadow casters: tris=%d sprites=%d glError=0x%x\n", PGXP_ShadowCasterCount(), PGXP_ShadowCasterSpriteCount(), (unsigned)glGetError());
+		}
+	}
+
+	glActiveTexture(GL_TEXTURE0);
+
+	g_pgl_PU1I(g_shadowProg, u_shPass, 2);
+}
+
+int GR_PS5_ShadowDumpPending() { return g_shDumpPending; }
+
+int GR_PS5_ShadowProjectInside(float x, float y, float z, int* insideXY)
+{
+	const float vx = (x + 0.5f) * g_shDispW * 128.0f, vy = (y + 0.5f) * g_shDispH * 128.0f, vz = z * 128.0f;
+	float w[3];
+	for (int j = 0; j < 3; j++)
+		w[j] = g_shM[0 * 3 + j] * vx + g_shM[1 * 3 + j] * vy + g_shM[2 * 3 + j] * vz;
+	float l[3];
+	for (int r = 0; r < 3; r++)
+		l[r] = g_shVP[0 * 4 + r] * w[0] + g_shVP[1 * 4 + r] * w[1] + g_shVP[2 * 4 + r] * w[2] + g_shVP[3 * 4 + r];
+	*insideXY = (fabsf(l[0]) <= 1.0f && fabsf(l[1]) <= 1.0f) ? 1 : 0;
+	return (*insideXY && fabsf(l[2]) <= 1.0f) ? 1 : 0;
+}
+
+// prints what the shader would do with one vertex: view -> world(camera relative) -> light clip space
+void GR_PS5_ShadowDebugVertex(float x, float y, float z, float scr_h)
+{
+	const float vx = (x + 0.5f) * g_shDispW * 128.0f, vy = (y + 0.5f) * g_shDispH * 128.0f, vz = z * 128.0f;
+	float w[3];
+	for (int j = 0; j < 3; j++)
+		w[j] = g_shM[0 * 3 + j] * vx + g_shM[1 * 3 + j] * vy + g_shM[2 * 3 + j] * vz;
+	float l[3];
+	for (int r = 0; r < 3; r++)
+		l[r] = g_shVP[0 * 4 + r] * w[0] + g_shVP[1 * 4 + r] * w[1] + g_shVP[2 * 4 + r] * w[2] + g_shVP[3 * 4 + r];
+	eprintf("shvtx: disp=%.0fx%.0f pos=(%.2f %.2f %.2f) scr_h=%.0f view=(%.0f %.0f %.0f) world=(%.0f %.0f %.0f) light=(%.2f %.2f %.2f)\n", g_shDispW, g_shDispH, x, y, z, scr_h, vx, vy, vz, w[0], w[1], w[2], l[0], l[1], l[2]);
+}
+
+void GR_PS5_ShadowDebug()
+{
+	eprintf("shadow: sun=(%.0f %.0f %.0f) fwd=(%.2f %.2f %.2f) focus=(%.0f %.0f %.0f) glError=0x%x\n", g_shDbgSun[0], g_shDbgSun[1], g_shDbgSun[2],
+		g_shDbgFwd[0], g_shDbgFwd[1], g_shDbgFwd[2], g_shDbgFocus[0], g_shDbgFocus[1], g_shDbgFocus[2], (unsigned)glGetError());
+}
+
+void GR_PS5_ShadowFinish()
+{
+	if (g_cfg_ps5Shadows && g_shadowFBO)
+		g_pgl_PU1I(g_shadowProg, u_shPass, 0);
+}
+#endif
