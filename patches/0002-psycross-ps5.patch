+
+static void ShcWorldToPx(const float* W, const short* M, float* out)
+{
+	for (int i = 0; i < 3; i++)
+		out[i] = (float)(((double)M[i * 3 + 0] * W[0] + (double)M[i * 3 + 1] * W[1] + (double)M[i * 3 + 2] * W[2]) / 4096.0 / 128.0);
+}
+
+// camera relative world space triangle -> same units as above
+static void ShcTriW(const float* w9, const short* M)
+{
+	if (g_shcCount >= SHC_MAX_TRIS)
+		return;
+	float* o = &g_shcTris[g_shcCount * 9];
+	for (int i = 0; i < 3; i++)
+		ShcWorldToPx(&w9[i * 3], M, &o[i * 3]);
+	g_shcCount++;
+}
+
+// a limb: two cross-shaped quads along a-b (a, b and the half width in camera relative world space, y is down)
+static void ShcLimbW(const float* a, const float* b, float hw, const short* M)
+{
+	float d[3] = { b[0] - a[0], b[1] - a[1], b[2] - a[2] };
+	const float dl = sqrtf(d[0] * d[0] + d[1] * d[1] + d[2] * d[2]);
+	if (dl < 1.0f)
+		return;
+	for (int i = 0; i < 3; i++) d[i] /= dl;
+	float o1[3] = { d[1] * 0.0f - d[2] * 1.0f, d[2] * 0.0f - d[0] * 0.0f, d[0] * 1.0f - d[1] * 0.0f };	// d x (0,1,0)
+	float l1 = sqrtf(o1[0] * o1[0] + o1[1] * o1[1] + o1[2] * o1[2]);
+	if (l1 < 0.01f) { o1[0] = 1.0f; o1[1] = 0.0f; o1[2] = 0.0f; l1 = 1.0f; }
+	for (int i = 0; i < 3; i++) o1[i] /= l1;
+	float o2[3] = { d[1] * o1[2] - d[2] * o1[1], d[2] * o1[0] - d[0] * o1[2], d[0] * o1[1] - d[1] * o1[0] };
+	const float* os[2] = { o1, o2 };
+	for (int q = 0; q < 2; q++)
+	{
+		const float* o = os[q];
+		float p0[3], p1[3], p2[3], p3[3];
+		for (int i = 0; i < 3; i++)
+		{
+			p0[i] = a[i] - o[i] * hw; p1[i] = a[i] + o[i] * hw;
+			p2[i] = b[i] + o[i] * hw; p3[i] = b[i] - o[i] * hw;
+		}
+		float t[9];
+		memcpy(&t[0], p0, 12); memcpy(&t[3], p1, 12); memcpy(&t[6], p2, 12); ShcTriW(t, M);
+		memcpy(&t[0], p0, 12); memcpy(&t[3], p2, 12); memcpy(&t[6], p3, 12); ShcTriW(t, M);
+	}
+}
+
+// limb between two points already in camera relative world space
+void PGXP_ShadowCasterLimbW(const float* a, const float* b, float hw, const short* M)
+{
+	ShcLimbW(a, b, hw, M);
+}
+
+// limb between two model space points transformed by the current GTE matrices
+void PGXP_ShadowCasterLimbG(const void* va, const void* vb, float hw, const short* M)
+{
+	// view space (GTE) -> camera relative world space: W = M^T * view / 4096, with view = TR + R v / 4096
+	const SVECTOR* v[2] = { (const SVECTOR*)va, (const SVECTOR*)vb };
+	float W[2][3];
+	for (int k = 0; k < 2; k++)
+	{
+		const double x = v[k]->vx, y = v[k]->vy, z = v[k]->vz;
+		const double vw[3] = {
+			(double)C2_TRX + ((double)C2_R11 * x + (double)C2_R12 * y + (double)C2_R13 * z) / 4096.0,
+			(double)C2_TRY + ((double)C2_R21 * x + (double)C2_R22 * y + (double)C2_R23 * z) / 4096.0,
+			(double)C2_TRZ + ((double)C2_R31 * x + (double)C2_R32 * y + (double)C2_R33 * z) / 4096.0 };
+		for (int i = 0; i < 3; i++)
+			W[k][i] = (float)(((double)M[0 * 3 + i] * vw[0] + (double)M[1 * 3 + i] * vw[1] + (double)M[2 * 3 + i] * vw[2]) / 4096.0);
+	}
+	ShcLimbW(W[0], W[1], hw, M);
+}
+
+// an upright box (pedestrians): centre in camera relative world space, y is down
+int g_shcBoxes = 0;
+void PGXP_ShadowCasterBox(const float* c, float hw, float yTop, float yBottom, const short* M)
+{
+	g_shcBoxes++;
+	float v[8][3];
+	for (int i = 0; i < 8; i++)
+	{
+		v[i][0] = c[0] + ((i & 1) ? hw : -hw);
+		v[i][1] = c[1] + ((i & 2) ? yBottom : yTop);
+		v[i][2] = c[2] + ((i & 4) ? hw : -hw);
+	}
+	static const int quads[6][4] = { {0,1,3,2}, {4,6,7,5}, {0,2,6,4}, {1,5,7,3}, {0,4,5,1}, {2,3,7,6} };
+	for (int q = 0; q < 6; q++)
+	{
+		float t[9];
+		const int a = quads[q][0], b = quads[q][1], cc = quads[q][2], d = quads[q][3];
+		memcpy(&t[0], v[a], 12); memcpy(&t[3], v[b], 12); memcpy(&t[6], v[cc], 12);
+		ShcTriW(t, M);
+		memcpy(&t[0], v[a], 12); memcpy(&t[3], v[cc], 12); memcpy(&t[6], v[d], 12);
+		ShcTriW(t, M);
+	}
+}
+
+// a textured quad facing the sun (the vertices are the billboard's model space vertices)
+void PGXP_ShadowCasterSprite(const void* const* v, const unsigned char* const* uv, unsigned short tpage, unsigned short clut, const short* M, int sx, int sy, int sz)
+{
+	if (g_shcSpriteCount >= SHC_MAX_SPRITES)
+		return;
+
+	float hx = (float)sx, hz = (float)sz;
+	float l = sqrtf(hx * hx + hz * hz);
+	if (l < 1.0f) { hx = 1.0f; hz = 0.0f; l = 1.0f; }
+	hx /= l; hz /= l;
+	const float rx = -hz, rz = hx;
+
+	const float TR[3] = { (float)C2_TRX / 128.0f, (float)C2_TRY / 128.0f, (float)C2_TRZ / 128.0f };
+
+	auto& e = g_shcSprites[g_shcSpriteCount++];
+	for (int k = 0; k < 4; k++)
+	{
+		const SVECTOR* sv = (const SVECTOR*)v[k];
+		const float x = (float)sv->vx, y = (float)sv->vy;
+		float W[3] = { rx * x, y, rz * x }, o[3];
+		ShcWorldToPx(W, M, o);
+		for (int i = 0; i < 3; i++)
+			e.p[k * 3 + i] = TR[i] + o[i];
+		e.uv[k * 2 + 0] = uv[k][0];
+		e.uv[k * 2 + 1] = uv[k][1];
+	}
+	e.tpage = tpage;
+	e.clut = clut;
+}
