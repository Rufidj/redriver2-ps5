 void GR_SwapWindow()
 {
 #if defined(RENDERER_OGL) || defined(RENDERER_OGLES)
+#ifdef __PROSPERO__
+	// present: draw our FBO texture to the swapchain buffer (glBlitFramebuffer on it is very slow here)
+	static double lastSwapEnd = 0.0;
+	const double beforePresent = PsyX_NowMs();
+	GR_PS5_Present();
+	const double beforeSwap = PsyX_NowMs();
+	PS5_SwapBuffers();
+	const double afterSwap = PsyX_NowMs();
+	GR_PS5_PerfEndFrame(lastSwapEnd > 0.0 ? beforeSwap - lastSwapEnd : 0.0, afterSwap - beforeSwap);
+	lastSwapEnd = afterSwap;
+	(void)beforePresent;
+	glBindFramebuffer(GL_FRAMEBUFFER, g_screenFBO);
+	GR_PS5_PerfMark(0);
+#else
 	SDL_GL_SwapWindow(g_window);
+#endif
 #endif
 
