+	{
+		const float* o = os[q];
+		float p0[3], p1[3], p2[3], p3[3];
+		for (int i = 0; i < 3; i++)
+		{
+			p0[i] = a[i] - o[i] * hw; p1[i] = a[i] + o[i] * hw;
+			p2[i] = b[i] + o[i] * hw; p3[i] = b[i] - o[i] * hw;
+		}
+		float t[9];
+		memcpy(&t[0], p0, 12); memcpy(&t[3], p1, 12); memcpy(&t[6], p2, 12); ShcTriW(t, M);
+		memcpy(&t[0], p0, 12); memcpy(&t[3], p2, 12); memcpy(&t[6], p3, 12); ShcTriW(t, M);
+	}
