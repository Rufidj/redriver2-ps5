+// colour of the haze: the configured one scaled by the game's sky brightness (so it darkens at night)
+void GR_PS5_SetFog(int skyR, int skyG, int skyB)
+{
+	if (!g_cfg_ps5Fog || !g_pgl_PU1F || !g_pgl_PU1I || !g_shadowProg)
+		return;
+	if (!g_ps5ModOn)
+	{
+		g_pgl_PU1I(g_shadowProg, u_fogOn, 0);
+		return;
+	}
+	const float k[3] = { skyR / 128.0f, skyG / 128.0f, skyB / 128.0f };
+	const float c[3] = { g_cfg_ps5FogR / 255.0f, g_cfg_ps5FogG / 255.0f, g_cfg_ps5FogB / 255.0f };
+	float o[3];
+	for (int i = 0; i < 3; i++) { o[i] = c[i] * (k[i] > 1.0f ? 1.0f : k[i]); }
+	// cells -> shader units (2048 world units per cell, 128 units per shader unit)
+	g_pgl_PU1F(g_shadowProg, u_fogR, o[0]);
+	g_pgl_PU1F(g_shadowProg, u_fogG, o[1]);
+	g_pgl_PU1F(g_shadowProg, u_fogB, o[2]);
+	g_pgl_PU1F(g_shadowProg, u_fogStart, g_cfg_ps5FogStart * 16.0f);
+	g_pgl_PU1F(g_shadowProg, u_fogEnd, g_cfg_ps5FogEnd * 16.0f);
+	g_pgl_PU1I(g_shadowProg, u_fogOn, 1);
