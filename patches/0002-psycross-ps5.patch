+int GR_PS5_ShadowProjectInside(float x, float y, float z, int* insideXY)
+{
+	const float vx = (x + 0.5f) * g_shDispW * 128.0f, vy = (y + 0.5f) * g_shDispH * 128.0f, vz = z * 128.0f;
+	float w[3];
+	for (int j = 0; j < 3; j++)
+		w[j] = g_shM[0 * 3 + j] * vx + g_shM[1 * 3 + j] * vy + g_shM[2 * 3 + j] * vz;
+	float l[3];
+	for (int r = 0; r < 3; r++)
+		l[r] = g_shVP[0 * 4 + r] * w[0] + g_shVP[1 * 4 + r] * w[1] + g_shVP[2 * 4 + r] * w[2] + g_shVP[3 * 4 + r];
+	*insideXY = (fabsf(l[0]) <= 1.0f && fabsf(l[1]) <= 1.0f) ? 1 : 0;
+	return (*insideXY && fabsf(l[2]) <= 1.0f) ? 1 : 0;
+}
