+	TexFormat runFormat[4] = { TF_4_BIT, TF_8_BIT, TF_16_BIT, TF_32_BIT_RGBA };
+	const int sprBase = base + nVerts;
+	for (int fmtIdx = 0; fmtIdx < 4; fmtIdx++)
