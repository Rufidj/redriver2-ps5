+	float hx = (float)sx, hz = (float)sz;
+	float l = sqrtf(hx * hx + hz * hz);
+	if (l < 1.0f) { hx = 1.0f; hz = 0.0f; l = 1.0f; }
+	hx /= l; hz /= l;
+	const float rx = -hz, rz = hx;
+
+	const float TR[3] = { (float)C2_TRX / 128.0f, (float)C2_TRY / 128.0f, (float)C2_TRZ / 128.0f };
