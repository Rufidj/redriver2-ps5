+// colour 0..255 as the game uses it; spot: dir is the unit direction of the cone and cone the cosine of its half angle
+// group: 0 none, otherwise lights of one car share a shadow map
+void PS5_LightAdd(const float* pos, const float* col255, float radius, const float* dir, float cone, int group)
+{
+	if (g_ps5LightCount >= PS5_MAX_LIGHTS)
+		return;
+	auto& l = g_ps5Lights[g_ps5LightCount++];
+	for (int i = 0; i < 3; i++) { l.pos[i] = pos[i]; l.col[i] = col255[i] / 255.0f; l.dir[i] = dir ? dir[i] : 0.0f; }
+	l.radius = radius;
+	l.cone = cone;
+	l.spot = dir ? 1.0f : 0.0f;
+	l.group = group;
+}
+
+// copies the lights nearest to the camera into the arrays the shader takes (a, b, c = vec4 each); returns how many
+int PS5_LightsNearest(int maxN, float* a, float* b, float* c, int* group)
+{
+	int idx[PS5_MAX_LIGHTS];
+	float dist[PS5_MAX_LIGHTS];
+	const int n = g_ps5LightCount;
+	for (int i = 0; i < n; i++)
+	{
+		idx[i] = i;
+		dist[i] = g_ps5Lights[i].pos[0] * g_ps5Lights[i].pos[0] + g_ps5Lights[i].pos[1] * g_ps5Lights[i].pos[1] + g_ps5Lights[i].pos[2] * g_ps5Lights[i].pos[2];
+	}
+	for (int i = 1; i < n; i++)	// insertion sort, n is small
+	{
+		const int k = idx[i]; const float d = dist[i]; int j = i - 1;
+		while (j >= 0 && dist[j] > d) { idx[j + 1] = idx[j]; dist[j + 1] = dist[j]; j--; }
+		idx[j + 1] = k; dist[j + 1] = d;
+	}
+	const int m = n < maxN ? n : maxN;
+	for (int i = 0; i < m; i++)
+	{
+		const auto& l = g_ps5Lights[idx[i]];
+		a[i * 4 + 0] = l.pos[0]; a[i * 4 + 1] = l.pos[1]; a[i * 4 + 2] = l.pos[2]; a[i * 4 + 3] = l.radius;
+		b[i * 4 + 0] = l.col[0]; b[i * 4 + 1] = l.col[1]; b[i * 4 + 2] = l.col[2]; b[i * 4 + 3] = l.cone;
+		c[i * 4 + 0] = l.dir[0]; c[i * 4 + 1] = l.dir[1]; c[i * 4 + 2] = l.dir[2]; c[i * 4 + 3] = l.spot;
+		group[i] = l.group;
+	}
+	return m;
