diff --git a/src/render/PsyX_render_ps5.cpp b/src/render/PsyX_render_ps5.cpp
new file mode 100644
index 0000000..9faf9f8
--- /dev/null
+++ b/src/render/PsyX_render_ps5.cpp
@@ -0,0 +1,86 @@
+// PS5 (ps5-opengl driver) EGL bootstrap for PsyX. Replaces SDL_GL_CreateContext, which does not work on G19.
+#ifdef __PROSPERO__
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <stdio.h>
+#include <stdarg.h>
+
+static EGLDisplay s_display = EGL_NO_DISPLAY;
+static EGLSurface s_surface = EGL_NO_SURFACE;
+static EGLContext s_context = EGL_NO_CONTEXT;
+
+void PS5_Log(const char* fmt, ...)
+{
+	FILE* fp = fopen("/app0/redriver2_egl.log", "a");
+	if (!fp)
+		return;
+	va_list args;
+	va_start(args, fmt);
+	vfprintf(fp, fmt, args);
+	va_end(args);
+	fputc('\n', fp);
+	fclose(fp);
+}
+
+extern "C" void* PS5_GetProcAddress(const char* name)
+{
+	return (void*)eglGetProcAddress(name);
+}
+
+int PS5_InitEGL(int* outWidth, int* outHeight)
+{
+	s_display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+	if (s_display == EGL_NO_DISPLAY || !eglInitialize(s_display, NULL, NULL) || !eglBindAPI(EGL_OPENGL_API))
+	{
+		PS5_Log("egl: FAIL display/init");
+		return 0;
+	}
+
+	static const EGLint configAttribs[] = {
+		EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+		EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
+		EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8,
+		EGL_DEPTH_SIZE, 24, EGL_STENCIL_SIZE, 8,
+		EGL_NONE,
+	};
+	EGLConfig config = NULL;
+	EGLint configCount = 0;
+	if (!eglChooseConfig(s_display, configAttribs, &config, 1, &configCount) || configCount != 1)
+	{
+		PS5_Log("egl: FAIL eglChooseConfig");
+		return 0;
+	}
+
+	s_surface = eglCreateWindowSurface(s_display, config, (EGLNativeWindowType)0, NULL);
+	static const EGLint ctxAttribs[] = {
+		EGL_CONTEXT_MAJOR_VERSION_KHR, 4,
+		EGL_CONTEXT_MINOR_VERSION_KHR, 6,
+		EGL_CONTEXT_OPENGL_PROFILE_MASK_KHR, EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT_KHR,
+		EGL_NONE,
+	};
+	s_context = eglCreateContext(s_display, config, EGL_NO_CONTEXT, ctxAttribs);
+	if (s_surface == EGL_NO_SURFACE || s_context == EGL_NO_CONTEXT || !eglMakeCurrent(s_display, s_surface, s_surface, s_context))
+	{
+		PS5_Log("egl: FAIL surface/context/makeCurrent");
+		return 0;
+	}
+
+	EGLint w = 0, h = 0;
+	eglQuerySurface(s_display, s_surface, EGL_WIDTH, &w);
+	eglQuerySurface(s_display, s_surface, EGL_HEIGHT, &h);
+	*outWidth = w;
+	*outHeight = h;
+	PS5_Log("egl: ok %dx%d", w, h);
+	return 1;
+}
+
+void PS5_SwapBuffers()
+{
+	eglSwapBuffers(s_display, s_surface);
+}
+
+void PS5_SetSwapInterval(int interval)
+{
+	eglSwapInterval(s_display, interval);
+}
+#endif
