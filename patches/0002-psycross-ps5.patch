+				double mn = 1e9, mx = -1e9; size_t filled = 0;
+				for (size_t i = 0; i < (size_t)S * S; i++)
+				{
+					if (px[i] < 0.99999f) { filled++; if (px[i] < mn) mn = px[i]; if (px[i] > mx) mx = px[i]; }
+				}
+				eprintf("shadowmap dump: filled=%.1f%% min=%.4f max=%.4f\n", 100.0 * filled / ((double)S * S), mn, mx);
+				for (int row = 0; row < 32; row++)
+				{
+					char line[80];
+					for (int col = 0; col < 64; col++)
+					{
+						// sample the block centre, scanning rows top (y = S-1) to bottom
+						const int x = col * S / 64 + S / 128, y = (31 - row) * S / 32 + S / 64;
+						const float d = px[(size_t)y * S + x];
+						line[col] = d >= 0.99999f ? '.' : (char)('0' + (int)(d * 9.99f));
+					}
+					line[64] = 0;
+					eprintf("sm %s\n", line);
+				}
+				free(px);
+			}
+		}
+	}
+
+	glActiveTexture(GL_TEXTURE0);
+
+	g_pgl_PU1I(g_shadowProg, u_shPass, 2);
+}
