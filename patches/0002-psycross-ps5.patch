+	if (g_cfg_ps5ShadowDebug == 5)
+	{
+		static int dumpCounter = 0;
+		if (++dumpCounter % 300 == 150)
+		{
+			const int S = g_cfg_ps5ShadowSize;
+			float* px = (float*)malloc((size_t)S * S * sizeof(float));
+			if (px)
