# Copy to scripts/env.sh and edit. Every path is absolute.
export NAB=$HOME/ps5-native-app-boilerplate          # checkout of blackbearreloaded/ps5-native-app-boilerplate (run `make deps` there once)
export PS5_OPENGL_SDK=$HOME/ps5-opengl-sdk/sdk        # the `sdk/` directory of a ps5-opengl SDK release (include/ + lib/libPS5OpenGL.a)
export SDL2_SDK=$HOME/ps5-opengl/build/native-sdl2-audio/sdk   # SDL2 for PS5 built by ps5-opengl (include/SDL2 + lib/libSDL2.a)
export PAYLOAD_LIB=$NAB/.deps/native/ps5-payload-sdk/target/lib # libc++.a libc++abi.a libunwind.a of ps5-payload-sdk
export PS5_IP=192.168.1.133                           # the console (it changes between boots: check it)
export PS5_FTP_PORT=2121                              # ftpsrv payload port
export TITLE_ID=PPSA00056
