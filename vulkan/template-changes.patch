diff --git a/ps5/tools/link-title.sh b/ps5/tools/link-title.sh
index 0d6d482..4aa6c60 100755
--- a/ps5/tools/link-title.sh
+++ b/ps5/tools/link-title.sh
@@ -66,13 +66,29 @@ if $platform_has_localeconv && [[ " ${radv_link_flags[*]} " != *" --defsym=local
     printf '{\n    local:\n        localeconv;\n};\n' > "$work/link/localeconv-local.map"
     radv_link_flags+=(--defsym=localeconv=ps5_localeconv --version-script "$work/link/localeconv-local.map")
 fi
+# The game: its archives (game/libred2vk.a and what it needs) and the wraps its glue binds
+game_inputs=()
+if [[ -f $root/game/libred2vk.a ]]; then
+    radv_link_flags+=(--wrap=fopen --wrap=mkdir -u red2_main -u main --allow-multiple-definition --error-limit=0)
+    game_inputs=("$root/game/libred2vk.a" ${RED2_EXTRA_ARCHIVES:-})
+fi
+link_once() {
 "$sdk/bin/prospero-lld" "${radv_linker_script[@]}" --eh-frame-hdr "${radv_link_flags[@]}" \
-    --version-script "$native/app-symbols.map" --exclude-libs=ALL \
+    --version-script "$native/app-symbols.map" "$@" --exclude-libs=ALL \
     -e _start -o "$work/link/llvm-pie.elf" \
     "$work/link/obj/app_crt.o" "${objects[@]}" \
     "$work/link/stubs/libSceAgc.so" "$work/link/stubs/libSceAgcDriver.so" \
-    "${radv_link_inputs[@]}" \
+    "${game_inputs[@]}" "${radv_link_inputs[@]}" \
     --as-needed "$sdk"/target/lib/*.so
+}
+# Mesa's dispatch tables name thousands of entry points no object defines through
+# weak references: with default visibility they land in .dynsym as undefined, and the
+# converter wants a provider for each. Defined as the absolute address 0 they are
+# the same null at run time and leave the import table.
+link_once
+"$sdk/bin/llvm-nm" -D "$work/link/llvm-pie.elf" | awk '$1 == "w" { printf "--defsym=%s=0\n", $2 }' \
+    > "$work/link/weak-null.rsp"
+link_once "@$work/link/weak-null.rsp"
